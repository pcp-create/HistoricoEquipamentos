# Backend somente. M8_API_URL é compatível com o nome existente na Vercel.
M8_API_URL=https://api.integra.m8sistemas.com.br
# Alternativa: M8_BASE_URL (se ambos existirem, precisam apontar para a mesma base).
M8_TENANT=
M8_USERNAME=
M8_PASSWORD=
M8_DOMAIN=app.erpm8.cloud
# Datas sem offset recebidas da M8 são locais neste fuso (Brasília).
M8_TIME_ZONE=America/Sao_Paulo
M8_COMPANIES=1,2,27404
# M8_COMPANIES tem precedência sobre M8_COMPANY legado (aceita lista também).
M8_COMPANY=
# Formato do retorno do token: caminho explícito, confirmar no m8:test.
M8_TOKEN_PATH=data.token
M8_TIMEOUT_MS=30000
M8_MAX_ATTEMPTS=4
M8_PAGE_SIZE=500
M8_MAX_RESPONSE_MB=64
# Só habilitar após os testes reais documentados em docs/validacao-m8.md.
M8_PAGINATION_VALIDATED=false
INITIAL_SYNC_START_DATE=2020-01-01
INITIAL_SYNC_WINDOW_MONTHS=1
INITIAL_SYNC_DATE_FIELD=atualizacao
SYNC_OVERLAP_MINUTES=10
# Exclusivo para teste: carga limitada NUNCA avança checkpoint.
SYNC_MAX_PAGES=
# Supabase > Connect: conexão direta ou Session pooler (porta 5432).
# Não usar Transaction pooler: o integrador mantém advisory lock de sessão.
DATABASE_URL=
# Opcional: arquivo CA baixado do Supabase para validar TLS.
DATABASE_SSL_CA_FILE=
# Apenas PostgreSQL local de testes:
DATABASE_SSL_DISABLED=false
# Referência para futuro frontend; não utilizadas pelo integrador PostgreSQL.
SUPABASE_URL=
SUPABASE_ANON_KEY=
