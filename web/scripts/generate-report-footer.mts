// Run from web/: node --import tsx scripts/generate-report-footer.mts
import {reportFooterHtml} from '../lib/reports/html-footer';
import {writeFileSync} from 'node:fs';
const template=reportFooterHtml('__GW_TITLE__','__GW_PAGE__');
const script=`// Generated by scripts/generate-report-footer.mts from lib/reports/html-footer.ts.
window.gwReportFooter = function(title, pageText) {
  function escape(s) { return String(s || "").replace(/[&<>"']/g, function(c) { return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;", "'":"&#39;"}[c]; }); }
  return ${JSON.stringify(template)}.replace("__GW_TITLE__", function(){return escape(title);}).replace("__GW_PAGE__", function(){return escape(pageText);});
};
`;
writeFileSync('public/tools/report-footer.js',script);
