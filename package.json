{
  "name": "historico-equipamentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "m8:test": "tsx src/scripts/testM8.ts",
    "m8:test:pagination": "tsx src/scripts/testM8.ts --pagination",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "sync:initial": "tsx src/index.ts INICIAL",
    "sync:incremental": "tsx src/index.ts INCREMENTAL",
    "sync:reprocess": "tsx src/index.ts REPROCESSAMENTO",
    "sync:test": "tsx src/index.ts TESTE",
    "sync:ids": "tsx src/scripts/syncIds.ts",
    "m8:inventory": "tsx src/scripts/inventory.ts",
    "sync:cycle": "tsx src/scripts/syncCycle.ts",
    "sync:status": "tsx src/scripts/syncStatus.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "sync:products": "tsx src/scripts/syncProducts.ts",
    "sync:products:status": "tsx src/scripts/productStatus.ts",
    "sync:equipment": "tsx src/scripts/syncEquipment.ts",
    "sync:equipment:status": "tsx src/scripts/equipmentStatus.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
