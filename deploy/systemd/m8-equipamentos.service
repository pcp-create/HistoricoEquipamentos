[Unit]
Description=Cadastro de equipamentos M8, clientes e vinculos com OS
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=m8-integrador
Group=m8-integrador
WorkingDirectory=/opt/m8-integrador
ExecStart=/usr/bin/node /opt/m8-integrador/dist/scripts/syncEquipment.js --max-people=100
TimeoutStartSec=infinity
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=m8-equipamentos
