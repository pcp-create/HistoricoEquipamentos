  "nodes": [
    {
      "id": "9b6f9763-a932-426b-a9cb-79c6be8e2562",
      "name": "Teste manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
